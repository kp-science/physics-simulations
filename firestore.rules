rules_version = '2';
// ═══════════════════════════════════════════════════════════════
// KP Science (lab.kpscience.com) — Firestore Security Rules
// Project: kp-science-f11ff   (deploy: firebase deploy --only firestore:rules)
//
// users/ + settings/  = ตรงกับ rules ที่ใช้งานจริงบน console (14 เม.ย. 2026)
// kpstats/            = ตัวนับผู้เข้าชม (kp-auth.js → kpStats) — เพิ่ม 2026-11-06
//
// (rules เดิมของไฟล์นี้เป็นของ Physics Quest อีกโปรเจกต์ → ย้ายไป firestore.physics-quest.rules)
// ═══════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'komanepapato@gmail.com';
    }

    // User docs (เดิม)
    match /users/{userId} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'komanepapato@gmail.com';
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Public settings — ทุกคนอ่านได้ (รวม anonymous), admin เขียนได้
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'komanepapato@gmail.com';
    }

    // ── ตัวนับผู้เข้าชม ─────────────────────────────────────────
    // ทุกคน (ไม่ต้องล็อกอิน) เพิ่มตัวนับได้ทีละ +1 เท่านั้น · ห้ามลด/ตั้งค่าเอง · ห้ามเพิ่มฟิลด์อื่น
    // อ่านได้เฉพาะแอดมิน
    function newCount(f) {      // ตอนสร้างเอกสาร: ไม่มีฟิลด์ หรือ = 1
      return !(f in request.resource.data) || request.resource.data[f] == 1;
    }
    function stepCount(f) {     // ตอนอัปเดต: เท่าเดิม หรือ +1
      return request.resource.data.get(f, 0) == resource.data.get(f, 0)
          || request.resource.data.get(f, 0) == resource.data.get(f, 0) + 1;
    }
    function shortStr(f, n) {
      return !(f in request.resource.data)
          || (request.resource.data[f] is string && request.resource.data[f].size() <= n);
    }

    match /kpstats/{env} {
      allow read, delete: if isAdmin();
      allow create: if env in ['site', 'dev']
        && request.resource.data.keys().hasOnly(['views', 'uniques'])
        && newCount('views') && newCount('uniques');
      allow update: if request.resource.data.keys().hasOnly(['views', 'uniques'])
        && stepCount('views') && stepCount('uniques');

      match /days/{day} {
        allow read, delete: if isAdmin();
        allow create: if env in ['site', 'dev']
          && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['views', 'uniques'])
          && newCount('views') && newCount('uniques');
        allow update: if request.resource.data.keys().hasOnly(['views', 'uniques'])
          && stepCount('views') && stepCount('uniques');
      }

      match /pages/{pageId} {
        allow read, delete: if isAdmin();
        allow create: if env in ['site', 'dev'] && pageId.size() <= 300
          && request.resource.data.keys().hasOnly(['opens', 'path', 'title'])
          && newCount('opens') && shortStr('path', 300) && shortStr('title', 200);
        allow update: if request.resource.data.keys().hasOnly(['opens', 'path', 'title'])
          && stepCount('opens') && shortStr('path', 300) && shortStr('title', 200);
      }

      match /online/{vid} {
        allow read, delete: if isAdmin();
        allow create, update: if env in ['site', 'dev'] && vid.size() <= 40
          && request.resource.data.keys().hasOnly(['t', 'p'])
          && request.resource.data.t == request.time
          && shortStr('p', 300);
      }
    }
  }
}
